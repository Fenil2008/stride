rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if the caller is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Function to check if caller is the owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Deny all unauthenticated access by default
    match /{document=**} {
      allow read, write: if false;
    }

    // User profiles: users/{uid}
    match /users/{userId} {
      // Any authenticated user can read profiles
      allow read: if isAuthenticated();
      // Only the account owner can create/update their profile
      allow write: if isOwner(userId);

      // Following relationship: users/{userId}/following/{followedUid}
      match /following/{followedUid} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId);
      }
    }

    // Activities: activities/{activityId}
    match /activities/{activityId} {
      // Any authenticated user can read public activities
      allow read: if isAuthenticated();
      
      // Only the author can create an activity
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      
      // Only the author can update or delete their activity
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // Activity comments: activities/{activityId}/comments/{commentId}
      match /comments/{commentId} {
        // Any authenticated user can read comments
        allow read: if isAuthenticated();
        
        // Authenticated user can create comment if it belongs to them
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
        
        // Comment author can update or delete comment
        allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      }

      // Activity kudos: activities/{activityId}/kudos/{uid}
      match /kudos/{kudoUid} {
        // Any authenticated user can view kudos
        allow read: if isAuthenticated();
        
        // Only the specific user can add or remove their own kudo
        allow write: if isAuthenticated() && request.auth.uid == kudoUid;
      }
    }
  }
}
